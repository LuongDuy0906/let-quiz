# Server Configuration
PORT=3000

# Database - MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/let-quiz?ssl=true&replicaSet=atlas-shard-0&authSource=admin&appName=LetQuizDatabase

# Cache - Redis
REDIS_URL=rediss://default:your_redis_password@your-redis-host.upstash.io:6379

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters
JWT_EXPIRATION_TIME=15m

# Refresh Token
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here_minimum_32_characters
REFRESH_TOKEN_EXPIRATION_TIME=7d

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Cloudinary - File Upload Service (Optional)
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service - Nodemailer (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@letquiz.com
